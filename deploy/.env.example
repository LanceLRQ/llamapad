# 部署参数示例：复制为 .env 后按本机情况填写（.env 不入库）

# 管理员首启密码（必填）
PANEL_ADMIN_PASSWORD=change-me

# docker.sock 的 gid（必填，因机器而异）：stat -c %g /var/run/docker.sock
# 面板经这个 gid 获得 docker.sock 读权限来管理兄弟容器；不填 compose 直接报错退出，
# 好过静默权限不足。即使下面 PUID 填 0（以 root 运行），这项也照样要填。
DOCKER_GID=

# 面板运行身份：必须对 data/ 与 models/ 两个目录可写。
# 取值对齐模型库属主（stat -c '%u:%g' models/），不设则默认 1000。
# 模型库属主为 root 时改填 0，并 chown -R 0:0 data 让面板数据目录同步对齐
# PUID=1000
# PGID=1000

# 宿主机时区（可选，默认 Asia/Shanghai；镜像内写死，这里可覆盖）
# TZ=Asia/Shanghai

# 宿主机端口（可选，默认 28960；容器内固定 28960）
# PANEL_PORT=28960

# ── 外部 LLM（可选）────────────────────────────────────────────
# OpenAI 兼容的 chat completions 服务，用于 README 推荐参数的 AI 解析。
# 面板只会向它发一段从 README 里切出来的候选片段，让它把作者写的采样参数
# 抠成 JSON；抠出来的每个值都必须能在 README 原文里字面命中，否则丢弃。
#
# 三项都填齐才算配置完成，留空则设置页里「外部 API」引擎显示为未配置。
# 也可以不用这里、改在面板设置页里填——两处都有时以本文件为准（只读，
# 面板不改写），与 HF_TOKEN 同一套优先级。
#
# BASE_URL 填到 /v1 为止，不要带 /chat/completions
# 官方 OpenAI:  https://api.openai.com/v1
# 本地 ollama:  http://host.docker.internal:11434/v1
# PANEL_LLM_BASE_URL=https://api.example.com/v1
# PANEL_LLM_API_KEY=sk-xxxxxxxx
# PANEL_LLM_MODEL=gpt-4o-mini
#
# 额外请求体字段（可选，一段 JSON，浅合并进 chat completions 请求体）。
# 用来传 provider 专属参数，面板不硬编码任何厂商字段。
# 最常见的用途是关掉推理模型的思考——实测同一个抽取请求，
# 开思考 1034 tokens、关思考 12 tokens，差 86 倍：
# PANEL_LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}
#
# 注意 model / messages / stream / response_format 由面板控制，
# 写在这里也会被覆盖。
